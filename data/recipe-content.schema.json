{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "모해묵지 요리 항목의 선택적 상세 콘텐츠",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "maxLength": 100
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "content": {
      "$ref": "#/$defs/content"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "amount": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "amount": {
          "$ref": "#/$defs/text"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["src", "alt", "credit", "sourceUrl", "license", "licenseUrl"],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^/(?!/)[a-zA-Z0-9_/-]+\\.(avif|webp|png|jpe?g|svg)$"
        },
        "alt": {
          "$ref": "#/$defs/text"
        },
        "credit": {
          "$ref": "#/$defs/text"
        },
        "sourceUrl": {
          "$ref": "#/$defs/url"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "licenseUrl": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "introduction",
        "difficulty",
        "servings",
        "ingredients",
        "seasonings",
        "steps",
        "sources"
      ],
      "properties": {
        "introduction": {
          "$ref": "#/$defs/text"
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "totalMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2880
        },
        "timeNote": {
          "$ref": "#/$defs/text"
        },
        "servings": {
          "$ref": "#/$defs/text"
        },
        "measurementNote": {
          "$ref": "#/$defs/text"
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "seasonings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/amount"
          }
        },
        "steps": {
          "$ref": "#/$defs/list"
        },
        "tips": {
          "$ref": "#/$defs/list"
        },
        "substitutions": {
          "$ref": "#/$defs/list"
        },
        "storage": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  }
}
