{
  "name": "mohaemookji",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "yarn": "1.22.x"
  },
  "scripts": {
    "start": "vite",
    "build": "node --experimental-strip-types scripts/build-recipes.ts && tsc --noEmit && vite build",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.154.0",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.72.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "husky": "^9.1.7"
  },
  "packageManager": "yarn@1.22.22"
}
